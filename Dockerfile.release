# syntax=docker/dockerfile:1
# SPDX-License-Identifier: Apache-2.0
# Used only by GoReleaser (dockers_v2): it supplies the prebuilt binary per platform.
# Local development images are built from Dockerfile (make docker).
FROM --platform=$BUILDPLATFORM busybox:1.38@sha256:a46257e06c82ad85242d0d38077d0a52d9896389ca60a1a59d3463db586e5fa4 AS state
RUN mkdir -p /out/var/lib/wake

FROM gcr.io/distroless/static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab
ARG TARGETPLATFORM
COPY ${TARGETPLATFORM}/wake /wake
COPY --from=state --chown=65532:65532 /out/var/lib/wake /var/lib/wake
USER 65532:65532
EXPOSE 9093
HEALTHCHECK --interval=10s --timeout=5s --start-period=5s --retries=3 CMD ["/wake","healthcheck"]
ENTRYPOINT ["/wake"]
CMD ["run"]
