#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
# Fast pre-commit checks. Always runs gitleaks; Go checks only
# when Go files are staged.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

if git diff --cached --name-only --diff-filter=ACMR | grep -q '\.go$'; then
	unformatted=$(git diff --cached --name-only --diff-filter=ACMR -- '*.go' | xargs go tool gofumpt -l)
	if [ -n "$unformatted" ]; then
		echo "pre-commit: gofumpt needed on:" >&2
		echo "$unformatted" >&2
		echo "run: make fmt" >&2
		exit 1
	fi
	golangci-lint run --new-from-rev=HEAD
fi

gitleaks protect --staged --no-banner --redact
